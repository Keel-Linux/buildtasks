APP=$(basename "$0")
fatal() { echo "FATAL [$APP]: $*" 1>&2; exit 1; }
info() { echo "INFO [$APP]: $*"; }

CLEANUP='/boot/*.bak /var/log/dpkg.log /var/log/apt/* /var/lib/apt/lists/* /var/cache/apt/archives/*.deb /var/cache/apt/*.bin'

usage() {
cat<<EOF
Syntax: $APP rootfs-dir
Cleans up logs, caches and leftover files in rootfs, and leaves it with an
empty /etc/machine-id (bin/reset-machine-id)
EOF
exit 1
}
if [[ "$#" != "1" ]]; then
    usage
fi

rootfs=$1
[[ -d "$rootfs" ]] || fatal "no such directory: $rootfs"

tklpatch-chroot "$rootfs" "rm -rf $CLEANUP"
fuser -k "$rootfs" || true

# Last, after every patch and package upgrade that ran in the chroot: the
# rootfs comes from the ISO, and systemd's postinst writes a machine-id of
# its own on every configure, so whatever ran since the ISO was made may
# have left one that every machine made from this image would share.
# reset-machine-id says what failed
"$(dirname "$(readlink -f "$0")")/reset-machine-id" "$rootfs" || exit 1
