# Leaves a root filesystem with the machine identity every image must ship:
# an empty /etc/machine-id and /var/lib/dbus/machine-id, when present, the
# link to it, so that each machine makes its own id at boot. The same reset
# bt-layer applies to every layer (layer_reset_machine_id in bin/layer-lib),
# for the images that do not go through bt-layer: the ISO, which bt-iso
# squashes from root.patched, and every image made from the ISO's rootfs
# (bt-vm, bt-container, bt-xen, bt-openstack and the others, through
# bin/rootfs-cleanup).

APP=$(basename "$0")
fatal() { echo "FATAL [$APP]: $*" 1>&2; exit 1; }

usage() {
cat<<EOF
Syntax: $APP rootfs-dir
Empties /etc/machine-id in rootfs-dir and links /var/lib/dbus/machine-id to it
EOF
exit 1
}
if [[ "$#" != "1" ]]; then
    usage
fi

rootfs=$1
[[ -d "$rootfs" ]] || fatal "no such directory: $rootfs"

# the library beside this script, whatever BT the caller exported
# shellcheck source=bin/layer-lib
source "$(dirname "$(readlink -f "$0")")/layer-lib"

layer_reset_machine_id "$rootfs" || fatal "cannot reset the machine-id of $rootfs"
