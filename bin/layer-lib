#!/bin/bash
# Copyright (c) 2026 KeelLinux
#
# This file is part of buildtasks.
#
# Buildtasks is free software; you can redistribute it and/or modify it
# under the terms of the GNU Affero General Public License as published by the
# Free Software Foundation; either version 3 of the License, or (at your
# option) any later version.
#
# Functions shared by bt-layer and tests/layer. Meant to be sourced. Every
# function reads its inputs from its arguments (SOURCE_DATE_EPOCH is the one
# environment variable consulted), prints its result on stdout and returns
# non-zero with a message on stderr instead of exiting, so the caller decides
# what is fatal.

# Common conf scripts that are driven by per-product variables and are safe
# to run again in a child layer.
LAYER_RERUN_CONF="apache-credit php"

# Common overlays that removelists-final/turnkey strips from every finished
# layer and that the conf scripts of a child layer need again.
LAYER_CHILD_OVERLAYS="turnkey.d/tkl-bashlib turnkey.d/systemd-chroot"

# Conf script that writes /tmp/ZZ_SSL_CIPHERS for the webserver conf scripts.
LAYER_SSL_CIPHERS_CONF="turnkey.d/zz-ssl-ciphers"
LAYER_SSL_CIPHERS_MARK="ZZ_SSL_CIPHERS"

# Paths left out of every layer tarball: the apt package cache and the apt
# binary caches are rebuilt by apt and fab already deletes them at the end of
# root.patched, which leaves only whiteouts behind.
LAYER_TAR_EXCLUDES="./var/cache/apt/archives/* ./var/cache/apt/*.bin"

# Submounts fab-chroot may leave behind under root.patched, deepest first.
LAYER_SUBMOUNTS="run dev/pts dev proc sys"

LAYER_ZSTD_LEVEL=19

# A unit is a component supplied to fab as a directory under the product's
# UNIT_DIRS, carrying any of these four inputs. fab resolves the plan, applies
# the overlay, runs the conf script and applies the removelist.
LAYER_UNIT_INPUTS="plan overlay conf removelist"

# What the manifest says when a layer has no unit, and what a field missing
# from an older manifest is read as. Never a valid unit name, since a name
# has to be followed by @version.
LAYER_UNITS_NONE=none

# A unit token is name@version. The name is the directory name, under the
# same rule as a layer name; the version has no @ and no space, so the two
# halves of a token are never ambiguous.
LAYER_UNIT_NAME_RE='^[a-z0-9][a-z0-9._-]*$'
LAYER_UNIT_VERSION_RE='^[A-Za-z0-9][A-Za-z0-9._+~-]*$'
LAYER_UNIT_VERSION_MAX=64

# The first line of a unit's version file that is neither blank nor a
# comment, trimmed of the whitespace around it
LAYER_UNIT_VERSION_AWK='{ sub(/#.*/, ""); gsub(/^[[:space:]]+|[[:space:]]+$/, ""); if ($0 != "") { print; exit } }'

# How many hex digits of the content digest a unit version keeps when the
# unit pins itself neither by a version file nor by being its own checkout.
LAYER_UNIT_DIGEST_LENGTH=16

layer_error() {
    echo "ERROR [layer-lib]: $*" 1>&2
    return 1
}

layer_kind() {
    local parent=$1
    if [[ -z "$parent" ]]; then
        echo rootfs
    else
        echo delta
    fi
}

layer_altstrap_path() {
    local fab_path=$1
    local codename=$2
    local arch=$3
    echo "$fab_path/altstraps/$codename-$arch.core"
}

layer_epoch() {
    local product_dir=$1
    local epoch=$SOURCE_DATE_EPOCH
    if [[ -z "$epoch" ]]; then
        epoch=$(git -C "$product_dir" log -1 --format=%ct 2>/dev/null) || epoch=
        if [[ -z "$epoch" ]]; then
            layer_error "SOURCE_DATE_EPOCH not set and no git history in $product_dir"
            return 1
        fi
    fi
    if [[ ! "$epoch" =~ ^[0-9]+$ ]]; then
        layer_error "SOURCE_DATE_EPOCH must be an integer, got '$epoch'"
        return 1
    fi
    echo "$epoch"
}

layer_git_commit() {
    local dir=$1
    git -C "$dir" rev-parse HEAD 2>/dev/null || echo none
}

layer_make_var() {
    local product_dir=$1
    local var=$2
    local out
    out=$(cd "$product_dir" && make debug V="$var" 2>&1 >/dev/null) || {
        layer_error "make debug V=$var failed in $product_dir"
        return 1
    }
    sed -n "s|^.*: $var = ||p" <<<"$out" | head -n 1 \
        | tr -s ' \t' ' ' | sed 's/^ //; s/ $//'
}

layer_words_has() {
    local list=$1
    local wanted=$2
    local word
    for word in $list; do
        [[ "$word" != "$wanted" ]] || return 0
    done
    return 1
}

layer_words_minus() {
    local list=$1
    local remove=$2
    local out=()
    local word
    for word in $list; do
        layer_words_has "$remove" "$word" || out+=("$word")
    done
    echo "${out[*]}"
}

# layer_needs_ssl_ciphers CONF_PATH CHILD_CONF OVERLAYS_PATH CHILD_OVERLAYS:
# true when a conf script the child runs reads the cipher list written by
# zz-ssl-ciphers, or when an overlay the child applies carries the mark it
# replaces (nginx keeps it in snippets/ssl.conf, not in a conf script).
layer_needs_ssl_ciphers() {
    local conf_path=$1
    local child_conf=$2
    local overlays_path=$3
    local child_overlays=$4
    local conf overlay
    for conf in $child_conf; do
        if grep -qs "$LAYER_SSL_CIPHERS_MARK" "$conf_path/$conf"; then
            return 0
        fi
    done
    for overlay in $child_overlays; do
        if [[ -d "$overlays_path/$overlay" ]] \
            && grep -rqs "$LAYER_SSL_CIPHERS_MARK" "$overlays_path/$overlay"; then
            return 0
        fi
    done
    return 1
}

layer_child_conf() {
    local full=$1
    local parent=$2
    local conf_path=$3
    local overlays_path=${4:-}
    local child_overlays=${5:-}
    local child out=() conf
    child=$(layer_words_minus "$full" "$parent")
    if layer_words_has "$full" turnkey.d; then
        out+=(turnkey.d/hostname)
        if layer_needs_ssl_ciphers "$conf_path" "$child" "$overlays_path" "$child_overlays"; then
            out+=("$LAYER_SSL_CIPHERS_CONF")
        fi
    fi
    for conf in $child; do
        out+=("$conf")
    done
    for conf in $LAYER_RERUN_CONF; do
        if layer_words_has "$full" "$conf" && ! layer_words_has "$child" "$conf"; then
            out+=("$conf")
        fi
    done
    echo "${out[*]}"
}

layer_child_overlays() {
    local full=$1
    local parent=$2
    local child
    child=$(layer_words_minus "$full" "$parent")
    echo "$LAYER_CHILD_OVERLAYS $child" | sed 's/ $//'
}

# layer_unit_content DIR: what the unit is made of, one line per path with
# its type, mode and symlink target, then the sha256 of every file. Sorted in
# the C locale, so the listing does not move with the caller's environment;
# .git is left out, so a unit that is its own checkout reads the same as the
# same files unpacked from a tarball.
layer_unit_content() {
    local dir=$1
    ( cd "$dir" && find . -path ./.git -prune -o -printf '%y %m %P %l\n' | LC_ALL=C sort ) || return 1
    ( cd "$dir" && find . -path ./.git -prune -o -type f -printf '%P\0' | LC_ALL=C sort -z | xargs -0 -r sha256sum ) || return 1
}

# layer_unit_digest DIR: a version for a unit that pins itself no other way,
# derived from what the directory holds.
layer_unit_digest() {
    local dir=$1
    local digest
    [[ -d "$dir" ]] || { layer_error "not a unit directory: $dir"; return 1; }
    digest=$(layer_unit_content "$dir" | sha256sum | cut -d ' ' -f 1) || return 1
    echo "sha256-${digest:0:$LAYER_UNIT_DIGEST_LENGTH}"
}

# layer_unit_version DIR: the version of one unit, from the first of three
# sources that answers.
#
#   a version file      the pin the recipe declared, written by whatever
#                       materialised unit.d; authoritative when present
#   its own git HEAD     a component checked out as its own repository, the
#                       same pin common_commit records for the shared tree;
#                       only when DIR is the top of that work tree, so the
#                       commit of an enclosing product repository is never
#                       passed off as the component's
#   the content digest   so that an assembled or scratch unit still has an
#                       identity, and two different contents never record
#                       the same version
layer_unit_version() {
    local dir=$1
    local name version toplevel
    name=$(basename "$dir")
    if [[ -f "$dir/version" ]]; then
        version=$(awk "$LAYER_UNIT_VERSION_AWK" "$dir/version")
        if [[ ! "$version" =~ $LAYER_UNIT_VERSION_RE ]] || [[ ${#version} -gt $LAYER_UNIT_VERSION_MAX ]]; then
            layer_error "unit '$name': $dir/version is not a version: '$version'"
            return 1
        fi
        echo "$version"
        return 0
    fi
    toplevel=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || toplevel=
    if [[ -n "$toplevel" ]] && [[ "$(readlink -f "$toplevel")" == "$(readlink -f "$dir")" ]]; then
        version=$(git -C "$dir" rev-parse HEAD 2>/dev/null) || version=
        if [[ -n "$version" ]]; then
            echo "$version"
            return 0
        fi
    fi
    layer_unit_digest "$dir"
}

# layer_unit_check DIR: refuse a unit directory fab would misread. An empty
# directory contributes nothing and means the assembly step went wrong, and a
# conf script without the execute bit is skipped by fab without a word, which
# is the same silent no-op the manifest work exists to end.
layer_unit_check() {
    local dir=$1
    local name input found=
    name=$(basename "$dir")
    for input in $LAYER_UNIT_INPUTS; do
        [[ ! -e "$dir/$input" ]] || found=yes
    done
    if [[ -z "$found" ]]; then
        layer_error "unit '$name' carries none of: $LAYER_UNIT_INPUTS"
        return 1
    fi
    if [[ -e "$dir/conf" && ! -x "$dir/conf" ]]; then
        layer_error "unit '$name': conf is not executable, so fab would skip it"
        return 1
    fi
    if [[ -e "$dir/overlay" && ! -d "$dir/overlay" ]]; then
        layer_error "unit '$name': overlay is not a directory"
        return 1
    fi
    return 0
}

# layer_units PRODUCT_DIR UNIT_DIRS: the units the product supplies, as
# name@version sorted by name, or none. UNIT_DIRS is the product-relative
# directory fab reads them from; empty means the product's fab has no unit
# support, which is not an error.
layer_units() {
    local product_dir=$1
    local unit_dirs=$2
    local base=$product_dir/$unit_dirs
    local path name version out=()
    if [[ -z "$unit_dirs" ]] || [[ ! -d "$base" ]]; then
        echo "$LAYER_UNITS_NONE"
        return 0
    fi
    for path in "$base"/*; do
        [[ -e "$path" ]] || continue
        name=$(basename "$path")
        if [[ ! -d "$path" ]]; then
            layer_error "$unit_dirs/$name is not a directory"
            return 1
        fi
        if [[ ! "$name" =~ $LAYER_UNIT_NAME_RE ]]; then
            layer_error "invalid unit name '$name' in $base"
            return 1
        fi
        layer_unit_check "$path" || return 1
        version=$(layer_unit_version "$path") || return 1
        out+=("$name@$version")
    done
    if [[ ${#out[@]} -eq 0 ]]; then
        echo "$LAYER_UNITS_NONE"
        return 0
    fi
    printf '%s\n' "${out[@]}" | LC_ALL=C sort | tr '\n' ' ' | sed 's/ $//'
}

# layer_units_version UNITS NAME: the version UNITS records for NAME, empty
# when it records none
layer_units_version() {
    local units=$1
    local wanted=$2
    local token
    for token in $units; do
        [[ "$token" != "$LAYER_UNITS_NONE" ]] || continue
        if [[ "${token%@*}" == "$wanted" ]]; then
            echo "${token##*@}"
            return 0
        fi
    done
    return 0
}

# layer_child_units OWN PARENT: the units this build has to apply, which are
# the ones the parent layer did not.
#
# A unit the parent applied at another version is refused rather than
# applied: a conf script runs once, so there is no move from one version of a
# component to another inside a child layer, and re-running the script on top
# of the old version is what breaks (conf/mysql symlinks /etc/init.d/mysql
# under bash -e and fails the second time). The parent is the thing to
# rebuild.
layer_child_units() {
    local own=$1
    local parent=$2
    local out=() token name version seen
    for token in $own; do
        [[ "$token" != "$LAYER_UNITS_NONE" ]] || continue
        name=${token%@*}
        version=${token##*@}
        seen=$(layer_units_version "$parent" "$name")
        if [[ -z "$seen" ]]; then
            out+=("$token")
        elif [[ "$seen" != "$version" ]]; then
            layer_error "unit '$name' is $version here and $seen in the parent" \
                "layer; a conf script runs once, so rebuild the parent instead"
            return 1
        fi
    done
    if [[ ${#out[@]} -eq 0 ]]; then
        echo "$LAYER_UNITS_NONE"
        return 0
    fi
    echo "${out[*]}"
}

# layer_units_merge PARENT OWN: every unit the finished layer carries, the
# parent's and this build's, sorted by name.
#
# The field is cumulative on purpose. A layer built on this one subtracts
# what this one records, so a component must stay recorded even when the
# recipe of this layer does not declare it: a child that carries no database
# content of its own still sits on the database, and its own child has to
# know that. Where both name the same unit the versions agree, because
# layer_child_units refuses the build otherwise.
layer_units_merge() {
    local parent=$1
    local own=$2
    local out=() token name
    for token in $own $parent; do
        [[ "$token" != "$LAYER_UNITS_NONE" ]] || continue
        name=${token%@*}
        [[ -z "$(layer_units_version "${out[*]}" "$name")" ]] || continue
        out+=("$token")
    done
    if [[ ${#out[@]} -eq 0 ]]; then
        echo "$LAYER_UNITS_NONE"
        return 0
    fi
    printf '%s\n' "${out[@]}" | LC_ALL=C sort | tr '\n' ' ' | sed 's/ $//'
}

# layer_unit_paths UNIT_DIRS UNITS: the directories fab has to apply, the
# value of its UNITS variable. Empty for none, which is what a child layer
# that inherits every one of its components passes.
layer_unit_paths() {
    local unit_dirs=$1
    local units=$2
    local out=() token
    for token in $units; do
        [[ "$token" != "$LAYER_UNITS_NONE" ]] || continue
        out+=("$unit_dirs/${token%@*}")
    done
    echo "${out[*]}"
}

layer_manifest_render() {
    local key value
    if [[ $(( $# % 2 )) -ne 0 ]]; then
        layer_error "manifest fields must come in key value pairs"
        return 1
    fi
    while [[ $# -gt 0 ]]; do
        key=$1
        value=$2
        shift 2
        if [[ ! "$key" =~ ^[a-z][a-z0-9_]*$ ]]; then
            layer_error "invalid manifest key '$key'"
            return 1
        fi
        echo "$key $value"
    done
}

layer_manifest_get() {
    local manifest=$1
    local key=$2
    local value
    if [[ ! -f "$manifest" ]]; then
        layer_error "manifest not found: $manifest"
        return 1
    fi
    value=$(sed -n "s|^$key ||p" "$manifest" | head -n 1)
    if [[ -z "$value" ]]; then
        layer_error "field '$key' missing in $manifest"
        return 1
    fi
    echo "$value"
}

# layer_manifest_opt MANIFEST KEY DEFAULT: the value of KEY, or DEFAULT when
# the manifest does not carry that field. Manifests written before a field
# existed stay usable as parents; a missing file is still an error.
layer_manifest_opt() {
    local manifest=$1
    local key=$2
    local default=$3
    local value
    if [[ ! -f "$manifest" ]]; then
        layer_error "manifest not found: $manifest"
        return 1
    fi
    value=$(sed -n "s|^$key ||p" "$manifest" | head -n 1)
    echo "${value:-$default}"
}

layer_tar_flags() {
    local epoch=$1
    local pattern
    echo "--sort=name"
    echo "--mtime=@$epoch"
    echo "--numeric-owner"
    echo "--format=posix"
    echo "--pax-option=exthdr.name=%d/PaxHeaders/%f,delete=atime,delete=ctime"
    echo "--xattrs"
    echo "--xattrs-include=trusted.overlay.*"
    echo "--xattrs-include=security.capability"
    echo "--warning=no-file-ignored"
    for pattern in $LAYER_TAR_EXCLUDES; do
        echo "--exclude=$pattern"
    done
}

layer_tar_members() {
    local kind=$1
    local build_dir=$2
    case $kind in
        rootfs)
            printf '%s\n' -C "$build_dir/root.patched" .
            ;;
        delta)
            printf '%s\n' -C "$build_dir/.deck/root.build/upper" .
            printf '%s\n' -C "$build_dir/.deck/root.patched/upper" .
            ;;
        *)
            layer_error "unknown layer kind '$kind'"
            return 1
            ;;
    esac
}

layer_audit_packages() {
    local rootfs=$1
    local broken
    broken=$(LAYER_DPKG_QUERY=${LAYER_DPKG_QUERY:-dpkg-query}; \
        command -v "$LAYER_DPKG_QUERY" >/dev/null || exit 3; \
        "$LAYER_DPKG_QUERY" --admindir="$rootfs/var/lib/dpkg" -f \
            '${Package} ${Status}\n' -W 2>/dev/null \
        | awk '$4 != "installed" && $2 != "unknown" { print $1 " (" $2 " " $3 " " $4 ")" }')
    if [[ $? -eq 3 ]]; then
        layer_error "dpkg-query not available, cannot audit $rootfs"
        return 1
    fi
    if [[ -n "$broken" ]]; then
        layer_error "packages left unconfigured or half-installed in $rootfs:"
        printf '  %s\n' $broken >&2
        return 1
    fi
    return 0
}

# A private key is a file with a PEM private key header on a line of its own:
# PKCS#8 (encrypted too), PKCS#1 (RSA, DSA, EC), OpenSSH and armoured OpenPGP
# secret keys, alone or after a certificate the way a combined cert.pem holds
# one. A marker quoted inside a line is not, and grep -I leaves out the
# binaries that carry the marker as a string. Binary key formats (DER,
# PKCS#12, Java keystores, PuTTY, a GnuPG private-keys-v1.d) are not seen;
# none was in any layer on 2026-09-29, and one that appears needs its own
# check rather than a wider pattern.
LAYER_PRIVATE_KEY_RE='^-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY( BLOCK)?-----$'

# Refuse a tree that carries a private key. Every image built from a layer
# holds the same bytes, so a key in a layer is a key every machine shares and
# anyone who downloads the layer has (keel-core#8): a host key is generated on
# the machine or it does not exist. The only keys accepted are the inert
# examples named in LIST, one "sha256 /path" per line, # starting a comment,
# each at its own path and digest; a package update that changes one fails
# here until a person has looked at the new file.
layer_audit_keys() {
    local rootfs=$1
    local list=$2
    local grep_bin=${LAYER_GREP:-grep}
    local hits rc path digest
    local -a found=()
    if [[ ! -d "$rootfs" ]]; then
        layer_error "no tree at $rootfs to audit for private keys"
        return 1
    fi
    if [[ ! -f "$list" ]]; then
        layer_error "no list of inert keys at $list"
        return 1
    fi
    if ! command -v "$grep_bin" >/dev/null; then
        layer_error "$grep_bin not available, cannot audit $rootfs for private keys"
        return 1
    fi
    # grep exits 1 when nothing matches; anything above that is a scan that
    # did not finish, which must not read as a clean tree
    rc=0
    hits=$("$grep_bin" -rlI -D skip -E "$LAYER_PRIVATE_KEY_RE" "$rootfs") || rc=$?
    if [[ $rc -gt 1 ]]; then
        layer_error "the private key scan of $rootfs failed with status $rc"
        return 1
    fi
    while IFS= read -r path; do
        [[ -n "$path" ]] || continue
        digest=$(sha256sum "$path" | cut -d ' ' -f 1)
        path=${path#"$rootfs"}
        if ! awk -v d="$digest" -v p="$path" \
            '!/^[[:space:]]*#/ && $1 == d && $2 == p { found = 1 } END { exit !found }' "$list"; then
            found+=("$path")
        fi
    done <<< "$hits"
    if [[ ${#found[@]} -gt 0 ]]; then
        layer_error "private keys in $rootfs, which every machine built from it would share:"
        printf '  %s\n' "${found[@]}" >&2
        echo "  remove them in the build (removelists-final) or, for an inert example, list it in $list" >&2
        return 1
    fi
    return 0
}

# The machine identity a layer ships. Every image built from a layer holds
# the same bytes, so an id in a layer is an id every machine made from it
# shares: the same DHCP DUID and IAID, the same journal and networkd
# identity, the same MariaDB server_id (docs/traps.md, "Every appliance built
# from core has the same machine-id"). The build always leaves one, whatever
# the parent shipped: the bootstrap carries one, and systemd's postinst runs
# systemd-machine-id-setup on every configure, so a child that upgrades
# systemd writes a fresh one of its own.
#
# /etc/machine-id is left an empty file, as Debian's cloud images ship it,
# and systemd makes the id at each machine's boot. Not missing and not
# "uninitialized": either makes that boot a first boot to systemd, which
# presets every unit and undoes what the build enabled and masked
# (machine-id(5), "First Boot Semantics"). D-Bus's copy becomes the link to
# it that tmpfiles.d/dbus.conf makes when it is absent, because systemd reads
# that file when /etc/machine-id is empty and would bring the old id back.
LAYER_MACHINE_ID=etc/machine-id
LAYER_DBUS_MACHINE_ID=var/lib/dbus/machine-id

# A tree already in that state is not written, so a child layer does not
# copy its parent's empty file up into its own tarball.
layer_reset_machine_id() {
    local rootfs=$1
    local id=$rootfs/$LAYER_MACHINE_ID
    local dbus=$rootfs/$LAYER_DBUS_MACHINE_ID
    if [[ ! -d "$rootfs/etc" ]]; then
        layer_error "no /etc in $rootfs to reset the machine-id in"
        return 1
    fi
    if [[ -L "$id" || ! -f "$id" || -s "$id" ]]; then
        if ! { rm -f "$id" && : > "$id" && chmod 0444 "$id"; } 2>/dev/null; then
            layer_error "cannot leave an empty /$LAYER_MACHINE_ID in $rootfs"
            return 1
        fi
    fi
    if [[ -e "$dbus" || -L "$dbus" ]] && [[ "$(readlink "$dbus")" != "/$LAYER_MACHINE_ID" ]]; then
        if ! { rm -f "$dbus" && ln -s "/$LAYER_MACHINE_ID" "$dbus"; } 2>/dev/null; then
            layer_error "cannot link /$LAYER_DBUS_MACHINE_ID to /$LAYER_MACHINE_ID in $rootfs"
            return 1
        fi
    fi
    return 0
}

layer_check_build() {
    local kind=$1
    local build_dir=$2
    local inert_keys=$3
    local dir
    if [[ ! -f "$build_dir/stamps/root.patched" ]]; then
        layer_error "$build_dir/stamps/root.patched missing - build failed or not run"
        return 1
    fi
    if [[ ! -x "$build_dir/root.patched/bin/bash" ]]; then
        layer_error "$build_dir/root.patched is not a rootfs - is the deck mounted? (make redeck)"
        return 1
    fi
    if ! layer_audit_packages "$build_dir/root.patched"; then
        return 1
    fi
    if ! layer_audit_keys "$build_dir/root.patched" "$inert_keys"; then
        return 1
    fi
    if [[ "$kind" == delta ]]; then
        for dir in root.build root.patched; do
            if [[ ! -d "$build_dir/.deck/$dir/upper" ]]; then
                layer_error "$build_dir/.deck/$dir/upper missing - not a deck build"
                return 1
            fi
        done
    fi
    return 0
}

layer_hash_size() {
    local file=$1
    if [[ ! -f "$file" ]]; then
        layer_error "file not found: $file"
        return 1
    fi
    echo "$(sha256sum "$file" | cut -d ' ' -f 1) $(stat -c %s "$file")"
}

layer_write_sha256() {
    local file=$1
    local sha256
    sha256=$(layer_hash_size "$file" | cut -d ' ' -f 1) || return 1
    echo "$sha256  $(basename "$file")" > "$file.sha256"
}

layer_umount_targets() {
    local root=$1
    local sub
    for sub in $LAYER_SUBMOUNTS; do
        if mountpoint -q "$root/$sub"; then
            echo "$root/$sub"
        fi
    done
    return 0
}

layer_parent_resolve() {
    local layers_dir=$1
    local parent=$2
    local rootfs=$layers_dir/$parent.rootfs
    local manifest=$layers_dir/$parent.manifest
    if [[ ! -x "$rootfs/bin/bash" ]]; then
        layer_error "parent rootfs not found: $rootfs (build the parent first)"
        return 1
    fi
    layer_manifest_get "$manifest" sha256
}

layer_parse_args() {
    LAYER_NAME=
    LAYER_PARENT=
    LAYER_USE_EXISTING=
    LAYER_HELP=
    LAYER_ERROR=
    while [[ $# -gt 0 ]]; do
        case $1 in
            --help|-h)
                LAYER_HELP=yes
                return 0
                ;;
            --parent|-p)
                if [[ -z "$2" ]]; then
                    LAYER_ERROR="$1 needs a layer name"
                    return 1
                fi
                LAYER_PARENT=$2
                shift
                ;;
            --use-existing|-u)
                LAYER_USE_EXISTING=yes
                ;;
            -*)
                LAYER_ERROR="unrecognized option: $1"
                return 1
                ;;
            *)
                if [[ -n "$LAYER_NAME" ]]; then
                    LAYER_ERROR="accepts only one layer name"
                    return 1
                fi
                LAYER_NAME=$1
                ;;
        esac
        shift
    done
    if [[ -z "$LAYER_NAME" ]]; then
        LAYER_ERROR="must give one layer name"
        return 1
    fi
    if [[ "$LAYER_NAME" == "$LAYER_PARENT" ]]; then
        LAYER_ERROR="a layer cannot be its own parent"
        return 1
    fi
    return 0
}
