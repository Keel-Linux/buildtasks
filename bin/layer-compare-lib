# option) any later version.
#
# Deciding whether a difference at a state path is noise or the change being
# measured. Sourced by bt-layer-measure after bin/layer-measure-lib.
#
# Why this is not a set of differing positions minus another set of differing
# positions. That was the first implementation and it cancelled a real
# difference against a coincidental one at the same place: an account added
# to /etc/shadow at the line number the control pair also appends at, a root
# password set on the line the control pair rewrites for a clock reason, a
# binary differing at the same offsets with different byte values, a file
# 3584 bytes shorter where the control pair varies by one. All four came back
# as noise, with the evidence suppressed because they were noise.
#
# So the control captures are the model, and the model has content in it. At
# each position the controls vary at, the longest common prefix and suffix of
# their variants is the shape of that variation; the unit is admitted only if
# its line has that shape. A mask with neither a prefix nor a suffix explains
# nothing, so it never yields noise. Bytes carry no shape at all, so a binary
# coincidence is never noise either: it is `overlapping`, which fails until
# somebody clears it in writing.
#
# Three or more control captures make the model better, because the floor is
# the union over every control pair and the magnitudes are a range rather
# than a single value.

# A line longer than this, or a file with no newline at all, is not text: a
# newline-free blob is one line, and one line masks against anything.
MEASURE_TEXT_MAX_LINE=8192

# Above this many differing positions the masking is abandoned and the path
# is reported as overlapping rather than guessed at.
MEASURE_POSITION_MAX=200

# Above this many differing bytes a binary is reported as overlapping without
# listing the offsets. A MariaDB ib_logfile0 is 100 MiB and two builds of it
# differ almost everywhere; materialising that list would put tens of
# millions of offsets into a shell variable.
MEASURE_OFFSET_MAX=20000

# The field separator inside a mask, which cannot occur in a text line.
MEASURE_MASK_SEP=$'\001'

# How many bytes of a window the binary evidence prints from each capture at
# the first differing offset. Eight covers a 32 or 64 bit counter, which is
# what most of these differences turn out to be.
MEASURE_WINDOW_BYTES=8

# How many lines of a diff the evidence block prints per pair, and how many
# paths get a full three-way diff before the rest are abbreviated to their
# summary line. Every `real` path is always printed in full. Both are read
# by bin/layer-report-lib.
# shellcheck disable=SC2034
MEASURE_EVIDENCE_LINES=20
# shellcheck disable=SC2034
MEASURE_EVIDENCE_PATHS=20

# ---------------------------------------------------------------------------
# primitives
# ---------------------------------------------------------------------------

# measure_is_text FILE
# No NUL, no control byte other than tab, newline and carriage return, at
# least one newline, and no line long enough to be a blob. Being wrong here
# is only safe in one direction: a binary treated as text gets masked line by
# line and can come out `noise`, while a text file treated as binary comes out
# `overlapping` and has to be cleared by hand. So the test is strict.
#
# It is strict rather than paranoid on purpose: mysql/user.frm is a TYPE=VIEW
# definition, which really is a text file whose only difference between builds
# is a `timestamp=` line, and calling it binary would bury that in a waiver.
measure_is_text() {
    local f=$1
    if [[ ! -f "$f" ]]; then
        measure_error "no such file: $f"
        return 1
    fi
    local all stripped
    all=$(wc -c < "$f")
    stripped=$(tr -d '\0' < "$f" | wc -c)
    [[ "$all" == "$stripped" ]] || return 1
    [[ "$(tr -dc '\1-\10\13\14\16-\37\177' < "$f" | wc -c)" -eq 0 ]] || return 1
    [[ "$(tr -dc '\n' < "$f" | wc -c)" -gt 0 ]] || return 1
    [[ "$(wc -L < "$f")" -le "$MEASURE_TEXT_MAX_LINE" ]] || return 1
    return 0
}

# measure_line N FILE
measure_line() {
    sed -n "$1{p;q}" "$2"
}

# measure_common_prefix STRING...
measure_common_prefix() {
    local out=$1 s i
    shift
    for s in "$@"; do
        i=0
        while [[ $i -lt ${#out} ]] && [[ "${s:$i:1}" == "${out:$i:1}" ]]; do
            i=$((i + 1))
        done
        out=${out:0:$i}
        [[ -n "$out" ]] || break
    done
    printf '%s\n' "$out"
}

# measure_common_suffix STRING...
measure_common_suffix() {
    local out=$1 s i
    shift
    for s in "$@"; do
        i=0
        while [[ $i -lt ${#out} ]] && [[ "${s: -$((i + 1)):1}" == "${out: -$((i + 1)):1}" ]]; do
            i=$((i + 1))
        done
        out=${out: ${#out}-$i}
        [[ -n "$out" ]] || break
    done
    printf '%s\n' "$out"
}

# measure_text_positions A B -> o<n> for a line of A that moved, n<n> for a
# line of B that is not in A where it was
measure_text_positions() {
    diff --old-line-format=$'o%dn\n' --new-line-format=$'n%dn\n' \
        --unchanged-line-format='' -- "$1" "$2" | LC_ALL=C sort -u
    return 0
}

# measure_byte_offsets A B -> the 1-based offsets differing in the common
# prefix of the two files, one per line
measure_byte_offsets() {
    if [[ ! -f "$1" ]] || [[ ! -f "$2" ]]; then
        measure_error "cannot compare $1 with $2: one of them is not a file"
        return 1
    fi
    cmp -l -- "$1" "$2" 2>/dev/null \
        | awk -v m="$MEASURE_OFFSET_MAX" 'NR > m { exit } { print $1 }' || true
    return 0
}

# measure_offsets_truncated A B
# True when the two files differ in at least MEASURE_OFFSET_MAX bytes, so the
# offset list above is a prefix and cannot be subtracted from anything.
measure_offsets_truncated() {
    [[ "$(measure_byte_offsets "$1" "$2" | grep -c . || true)" -ge "$MEASURE_OFFSET_MAX" ]]
}

# measure_pair_positions KIND A B
measure_pair_positions() {
    if [[ "$1" == text ]]; then
        measure_text_positions "$2" "$3"
        return 0
    fi
    measure_byte_offsets "$2" "$3"
}

# measure_floor_positions KIND CONTROL... -> the union over every unordered
# pair of control captures. Three controls give three pairs, which is the
# point of allowing more than two.
measure_floor_positions() {
    local kind=$1
    shift
    local -a c=("$@")
    local i j all=""
    for i in $(seq 0 $(( ${#c[@]} - 1 ))); do
        for j in $(seq $(( i + 1 )) $(( ${#c[@]} - 1 ))); do
            all+=$(measure_pair_positions "$kind" "${c[$i]}" "${c[$j]}")$'\n'
        done
    done
    [[ -n "${all//[$'\n']/}" ]] || return 0
    LC_ALL=C sort -u <<<"$all" | grep .
    return 0
}

# measure_range size|bytes CONTROL... -> "MIN MAX" over every ordered pair of
# distinct controls, of the size delta or of the number of differing bytes.
# Ordered, so the range is symmetric: which control is written first is an
# accident of the command line and must not decide whether the unit fits.
measure_range() {
    local what=$1
    shift
    local -a c=("$@")
    local i j v min="" max=""
    for i in $(seq 0 $(( ${#c[@]} - 1 ))); do
        for j in $(seq 0 $(( ${#c[@]} - 1 ))); do
            [[ $i -ne $j ]] || continue
            if [[ "$what" == size ]]; then
                v=$(( $(wc -c < "${c[$j]}") - $(wc -c < "${c[$i]}") ))
            else
                v=$(measure_byte_offsets "${c[$i]}" "${c[$j]}" | grep -c . || true)
            fi
            [[ -n "$min" ]] && [[ "$v" -ge "$min" ]] || min=$v
            [[ -n "$max" ]] && [[ "$v" -le "$max" ]] || max=$v
        done
    done
    printf '%s %s\n' "${min:-0}" "${max:-0}"
}

# measure_mask_at N CONTROL... -> PREFIX<SEP>SUFFIX, the shape the controls
# show at line N
measure_mask_at() {
    local n=$1
    shift
    local -a lines=()
    local f
    for f in "$@"; do
        lines+=("$(measure_line "$n" "$f")")
    done
    printf '%s%s%s\n' \
        "$(measure_common_prefix "${lines[@]}")" \
        "$MEASURE_MASK_SEP" \
        "$(measure_common_suffix "${lines[@]}")"
}

# measure_mask_admits LINE PREFIX SUFFIX
# A mask with neither a prefix nor a suffix admits nothing: it is what two
# unrelated lines have in common, which is no evidence about a third.
measure_mask_admits() {
    local line=$1 prefix=$2 suffix=$3
    [[ -n "$prefix" ]] || [[ -n "$suffix" ]] || return 1
    [[ ${#line} -ge $(( ${#prefix} + ${#suffix} )) ]] || return 1
    [[ "$line" == "$prefix"* ]] || return 1
    [[ -z "$suffix" ]] || [[ "$line" == *"$suffix" ]] || return 1
    return 0
}

# measure_cleared_reason FILE PATH -> the reason a waiver gives, or nothing
#
# A waiver line is PATH<TAB>REASON, and PATH may be a glob, because a real
# MariaDB data directory is 173 files that one sentence explains. A glob
# waiver is only honest because the report names every path it covered, so
# it is a record of what was waived and not a way of not looking.
measure_cleared_reason() {
    local file=$1 path=$2 rule reason line
    [[ -f "$file" ]] || return 0
    local -a rules=()
    mapfile -t rules < "$file"
    for line in "${rules[@]}"; do
        IFS=$'\t' read -r rule reason <<<"$line"
        [[ -n "$rule" ]] || continue
        [[ "$rule" != \#* ]] || continue
        # shellcheck disable=SC2053
        if [[ "$path" == "$rule" ]] || [[ "$path" == $rule ]]; then
            printf '%s\n' "$reason"
            return 0
        fi
    done
    return 0
}

# ---------------------------------------------------------------------------
# the verdict
# ---------------------------------------------------------------------------

# measure_verdict UNIT CONTROL... -> verdict<TAB>why
#
#   none         the unit is byte identical to the control
#   noise        every difference is at a position the controls vary at and
#                has the shape the controls show there
#   overlapping  every difference coincides with the controls' variation but
#                its content cannot be shown to be that variation; bytes
#                never can, and neither can a mask with nothing in it
#   real         it differs where the controls do not vary, or with content
#                or a magnitude they do not show
#   unsampled    some side has no bytes, so nothing can be said
measure_verdict() {
    local unit=$1
    shift
    if [[ $# -lt 1 ]]; then
        measure_error "measure_verdict needs a unit sample and at least one control"
        return 1
    fi
    local f
    for f in "$unit" "$@"; do
        if [[ ! -f "$f" ]]; then
            printf 'unsampled\t%s\n' \
                "no bytes kept for $f, so neither noise nor a real difference can be shown"
            return 0
        fi
    done
    local base=$1
    if cmp -s -- "$base" "$unit"; then
        printf 'none\t%s\n' "identical to the control"
        return 0
    fi
    local kind=binary
    if measure_is_text "$base" && measure_is_text "$unit"; then
        kind=text
    fi
    if [[ "$kind" == binary ]]; then
        measure_verdict_binary "$unit" "$@"
        return 0
    fi
    local floor unit_pos outside n
    floor=$(measure_floor_positions "$kind" "$@")
    unit_pos=$(measure_pair_positions "$kind" "$base" "$unit")
    outside=$(measure_set_minus "$unit_pos" "$floor")
    if [[ -n "$outside" ]]; then
        printf 'real\t%s\n' \
            "differs where the controls do not vary: $(measure_nature_list "$outside")"
        return 0
    fi
    n=$(grep -c . <<<"$unit_pos" || true)
    if [[ "$n" -gt "$MEASURE_POSITION_MAX" ]]; then
        printf 'overlapping\t%s\n' \
            "$n differing positions, too many to mask (the cap is $MEASURE_POSITION_MAX); read the evidence"
        return 0
    fi
    measure_verdict_text "$unit_pos" "$unit" "$@"
}

# measure_verdict_text POSITIONS UNIT CONTROL...
measure_verdict_text() {
    local positions=$1 unit=$2
    shift 2
    local token n mask prefix suffix line unexplained=0 masked=0
    while IFS= read -r token; do
        [[ -n "$token" ]] || continue
        n=${token#[on]}
        mask=$(measure_mask_at "$n" "$@")
        prefix=${mask%%"$MEASURE_MASK_SEP"*}
        suffix=${mask#*"$MEASURE_MASK_SEP"}
        line=$(measure_line "$n" "$unit")
        if measure_mask_admits "$line" "$prefix" "$suffix"; then
            masked=$((masked + 1))
            continue
        fi
        if [[ -z "$prefix" ]] && [[ -z "$suffix" ]]; then
            printf 'overlapping\t%s\n' \
                "line $n varies in the controls with nothing in common, so nothing about it can be shown; read the evidence"
            return 0
        fi
        unexplained=$((unexplained + 1))
        printf 'real\t%s\n' \
            "line $n does not have the shape the controls vary with there (prefix '$prefix', suffix '$suffix')"
        return 0
    done <<<"$positions"
    printf 'noise\t%s\n' \
        "$masked differing lines, every one of them matching the mask the controls establish at that line"
    return 0
}

# measure_verdict_binary UNIT CONTROL...
# Bytes carry no shape, so the best this can say is that the unit coincides
# with the controls in position, in size delta and in how much differs.
measure_verdict_binary() {
    local unit=$1 base=$2
    shift
    local delta count dmin dmax cmin cmax floor outside
    delta=$(( $(wc -c < "$unit") - $(wc -c < "$base") ))
    count=$(measure_byte_offsets "$base" "$unit" | grep -c . || true)
    if measure_offsets_truncated "$base" "$unit"; then
        printf 'overlapping\t%s\n' \
            "at least $MEASURE_OFFSET_MAX bytes differ, too many to compare offset by offset; size delta $delta, and the evidence names the first of them"
        return 0
    fi
    floor=$(measure_floor_positions binary "$@")
    outside=$(measure_set_minus "$(measure_byte_offsets "$base" "$unit")" "$floor")
    [[ -z "$outside" ]] || outside="@$outside"
    if [[ -n "$outside" ]]; then
        printf 'real\t%s\n' \
            "differs at bytes the controls do not vary at: $(measure_nature_list "${outside//$'\n'/$'\n@'}")"
        return 0
    fi
    read -r dmin dmax < <(measure_range size "$@")
    read -r cmin cmax < <(measure_range bytes "$@")
    if [[ "$delta" -lt "$dmin" ]] || [[ "$delta" -gt "$dmax" ]]; then
        printf 'real\t%s\n' \
            "size moves by $delta bytes where the controls move by $dmin to $dmax"
        return 0
    fi
    if [[ "$count" -lt "$cmin" ]] || [[ "$count" -gt "$cmax" ]]; then
        printf 'real\t%s\n' \
            "$count bytes differ where the controls differ by $cmin to $cmax"
        return 0
    fi
    printf 'overlapping\t%s\n' \
        "$count bytes at offsets the controls also vary at, size delta $delta within $dmin to $dmax; bytes carry no shape, so this is a coincidence nobody has ruled out"
    return 0
}

# ---------------------------------------------------------------------------
# evidence, printed for every verdict including noise
# ---------------------------------------------------------------------------

# measure_evidence PATH UNIT CONTROL...
measure_evidence() {
    local path=$1 unit=$2
    shift 2
    local base=$1 f
    echo "  $path"
    for f in "$unit" "$@"; do
        if [[ ! -f "$f" ]]; then
            echo "    not sampled: $f is absent, raise --state-max-bytes and capture again"
            return 0
        fi
    done
    echo "    control vs unit:"
    measure_pair_evidence "$base" "$unit"
    local i=2
    for f in "$@"; do
        [[ "$f" != "$base" ]] || continue
        echo "    control vs control $i (the floor at this path):"
        measure_pair_evidence "$base" "$f"
        i=$((i + 1))
    done
    measure_window_evidence "$unit" "$@"
    return 0
}

# measure_window_evidence UNIT CONTROL...
# For a binary, the bytes themselves at the first offset that differs, from
# every capture. This is what settles a difference by hand: read down the
# column and a value that climbs with capture time is a clock, while a value
# that changes only in the unit is the change being measured. Without it a
# reviewer gets a list of offsets and no way to tell those apart.
measure_window_evidence() {
    local unit=$1 base=$2
    shift
    measure_is_text "$base" && return 0
    local off f
    off=$(measure_byte_offsets "$base" "$unit" | head -1)
    [[ -n "$off" ]] || return 0
    printf '      the %s bytes at offset %s, in capture order:\n' \
        "$MEASURE_WINDOW_BYTES" "$off"
    for f in "$@" "$unit"; do
        printf '        %-12s %s\n' "$(measure_window_label "$f" "$unit")" \
            "$(dd if="$f" bs=1 skip=$((off - 1)) count="$MEASURE_WINDOW_BYTES" \
                status=none 2>/dev/null | od -An -tx1 | tr -s ' ' | tr -d '\n')"
    done
    return 0
}

# measure_window_label FILE UNIT
measure_window_label() {
    if [[ "$1" == "$2" ]]; then
        echo unit
    else
        echo control
    fi
}

# measure_pair_evidence A B
measure_pair_evidence() {
    local a=$1 b=$2
    if measure_is_text "$a" && measure_is_text "$b"; then
        diff -u --label control --label other -- "$a" "$b" \
            | tail -n +3 | head -n "$MEASURE_EVIDENCE_LINES" | sed 's/^/      /' || true
        return 0
    fi
    local all n offsets
    all=$(measure_byte_offsets "$a" "$b")
    n=$(grep -c . <<<"$all" || true)
    offsets=$(head -n "$MEASURE_LIST_MAX" <<<"$all" | paste -sd, - || true)
    printf '      sizes %s and %s; differing bytes: %s; first offsets: %s\n' \
        "$(wc -c < "$a")" "$(wc -c < "$b")" "$n" "${offsets:-none}"
    return 0
}
