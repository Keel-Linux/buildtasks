info "22: bt-layer with units (a component supplied as a fab unit)"
# add_unit PRODUCT NAME VERSION: a unit fab would apply, pinned by a version
# file the way an assembly step would write it
add_unit() {
    local dir=$tmp/products/$1/unit.d/$2
    mkdir -p "$dir/overlay/etc"
    echo "$2" > "$dir/overlay/etc/$2.conf"
    printf '#!/bin/sh\ntrue\n' > "$dir/conf"
    chmod 755 "$dir/conf"
    : > "$dir/plan"
    echo "$3" > "$dir/version"
}
assert_eq core-units "$(layer_manifest_get "$L/core.manifest" units)" none
assert_eq core-build-units "$(layer_manifest_get "$L/core.manifest" build_units)" default
assert_eq lamp-units "$(layer_manifest_get "$L/lamp.manifest" units)" none
assert_eq lamp-build-units "$(layer_manifest_get "$L/lamp.manifest" build_units)" none
assert_eq lamp-units-used "$(cat "$tmp/products/lamp/build/units.used")" ""

write_product "$tmp/products/db" "turnkey.d mysql" "turnkey.d mysql"
add_unit db mariadb 1.0.0
"$sbt/bt-layer" db >/dev/null
assert_eq db-units "$(layer_manifest_get "$L/db.manifest" units)" "mariadb@1.0.0"
assert_eq db-build-units "$(layer_manifest_get "$L/db.manifest" build_units)" default
assert_eq db-units-used "$(cat "$tmp/products/db/build/units.used")" "unit.d/mariadb"

