info "10d: layer_reset_machine_id"
# the machine-id every image carried on 2026-09-30, and the D-Bus copy of it
# dbus-daemon's postinst wrote as a file of its own
mid_root=$tmp/midfs
mkdir -p "$mid_root/etc" "$mid_root/var/lib/dbus"
echo f0e97605ab594989b4d78f4a126b5b37 > "$mid_root/etc/machine-id"
chmod 0444 "$mid_root/etc/machine-id"
cp "$mid_root/etc/machine-id" "$mid_root/var/lib/dbus/machine-id"
layer_reset_machine_id "$mid_root"
[[ -f "$mid_root/etc/machine-id" && ! -L "$mid_root/etc/machine-id" ]] || fatal "mid-reset: not a regular file"
[[ ! -s "$mid_root/etc/machine-id" ]] || fatal "mid-reset: the id is still there"
assert_eq mid-mode "$(stat -c %a "$mid_root/etc/machine-id")" 444
[[ -L "$mid_root/var/lib/dbus/machine-id" ]] || fatal "mid-dbus: not a symlink"
assert_eq mid-dbus-target "$(readlink "$mid_root/var/lib/dbus/machine-id")" /etc/machine-id
# a tree already reset is left as it is, so a child layer does not copy the
# parent's empty file up into its own tarball
touch -d @1234567890 "$mid_root/etc/machine-id"
chmod 0644 "$mid_root/etc/machine-id"
touch -h -d @1234567890 "$mid_root/var/lib/dbus/machine-id"
layer_reset_machine_id "$mid_root"
assert_eq mid-untouched "$(stat -c '%a %Y' "$mid_root/etc/machine-id")" "644 1234567890"
assert_eq mid-dbus-untouched "$(stat -c %Y "$mid_root/var/lib/dbus/machine-id")" 1234567890
# missing means a first boot to systemd, which presets every unit: an empty
# file is made
rm "$mid_root/etc/machine-id"
layer_reset_machine_id "$mid_root"
[[ -f "$mid_root/etc/machine-id" && ! -s "$mid_root/etc/machine-id" ]] || fatal "mid-missing: no empty file"
# a symlink, even to an empty file, is replaced by a file of the tree's own
rm "$mid_root/etc/machine-id"
: > "$tmp/elsewhere-id"
ln -s "$tmp/elsewhere-id" "$mid_root/etc/machine-id"
layer_reset_machine_id "$mid_root"
[[ -f "$mid_root/etc/machine-id" && ! -L "$mid_root/etc/machine-id" ]] || fatal "mid-symlink: still a link"
# a D-Bus link to anything but /etc/machine-id is replaced
ln -sfn /var/lib/dbus/other "$mid_root/var/lib/dbus/machine-id"
layer_reset_machine_id "$mid_root"
assert_eq mid-dbus-relink "$(readlink "$mid_root/var/lib/dbus/machine-id")" /etc/machine-id
# no D-Bus copy stays none: tmpfiles.d/dbus.conf makes the link at boot
rm "$mid_root/var/lib/dbus/machine-id"
layer_reset_machine_id "$mid_root"
[[ ! -e "$mid_root/var/lib/dbus/machine-id" && ! -L "$mid_root/var/lib/dbus/machine-id" ]] \
    || fatal "mid-no-dbus: a D-Bus copy was made"
expect_fail mid-no-etc layer_reset_machine_id "$tmp/no-such-root"
out=$(layer_reset_machine_id "$tmp/no-such-root" 2>&1) || true
[[ "$out" == *"no /etc"* ]] || fatal "mid-no-etc: unexpected message: $out"
rm "$mid_root/etc/machine-id"
mkdir "$mid_root/etc/machine-id"
expect_fail mid-directory layer_reset_machine_id "$mid_root"
rmdir "$mid_root/etc/machine-id"
mkdir -p "$mid_root/var/lib/dbus/machine-id/x"
expect_fail mid-dbus-directory layer_reset_machine_id "$mid_root"
out=$(layer_reset_machine_id "$mid_root" 2>&1) || true
[[ "$out" == *"cannot link /var/lib/dbus/machine-id"* ]] || fatal "mid-dbus-directory: unexpected message: $out"
rm -r "$mid_root/var/lib/dbus/machine-id"

