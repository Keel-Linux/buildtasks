#!/bin/bash -e
# Test bt-layer and bin/layer-lib against scratch directories. Nothing is
# built: products are fake Makefiles, fab and the signature helper are stubs.
#
# Code paths covered:
#   layer-lib: layer_kind (rootfs, delta); layer_altstrap_path; layer_epoch
#     (env, env invalid, git fallback, no git); layer_git_commit (git, none);
#     layer_make_var (ok, failure); layer_words_has; layer_words_minus;
#     layer_child_conf (stack on core with ssl ciphers, app on stack, no
#     turnkey.d, overlay carrying the ciphers mark, overlay without it);
#     layer_needs_ssl_ciphers; layer_child_overlays; layer_unit_content and
#     layer_unit_digest (same content, file content, directory mode, symlink,
#     symlink target, .git ignored, missing directory); layer_unit_version
#     (version file, comments and whitespace, not a version, an @ in it, too
#     long, own checkout, a unit inside another repository, digest);
#     layer_unit_check (every input, plan only, empty, conf not executable,
#     overlay not a directory); layer_units (no unit.d, no UNIT_DIRS, empty
#     unit.d, sorted, not a directory, bad name, hollow unit);
#     layer_units_version (found, absent, none); layer_child_units (parent
#     has none, has one of two, has both, own none, version conflict);
#     layer_units_merge (none, own only, parent only, union, overlap);
#     layer_unit_paths (none, two); layer_manifest_render (ok, odd args,
#     bad key); layer_manifest_get (ok, missing file, missing key);
#     layer_manifest_opt (present, absent, missing file);
#     layer_tar_flags; layer_tar_members (rootfs, delta, unknown);
#     layer_audit_packages (clean, unconfigured package);
#     layer_audit_keys (clean, no list, no root, a PKCS#8 key named by its
#     image path, an OpenPGP secret key and not a public one,
#     a key after a certificate, two OpenSSH and EC keys both
#     named, a quoted marker, a binary, a symlink out of the tree, an example
#     unlisted, listed, its digest elsewhere, its path with another digest,
#     grep failing, grep missing, the committed list well formed);
#     layer_reset_machine_id (an id and a D-Bus copy, already reset and
#     left untouched, missing, a symlink, a D-Bus link elsewhere, no D-Bus
#     copy, no /etc, a directory in the way of either);
#     layer_check_build (ok, no stamp, not mounted, no upper, a private key,
#     no key list);
#     layer_hash_size (ok, missing); layer_write_sha256; layer_umount_targets
#     (none, mounted); layer_parent_resolve (ok, no rootfs, no manifest);
#     layer_parse_args (help, name, parent, use-existing, no name, two
#     names, unknown option, parent without value, self parent).
#   bt-layer: --help; usage error; missing config; missing FAB_PATH; missing
#     product; bad epoch; rootfs build with warning on BT_GPGKEY, exported
#     with an empty machine-id whatever the build left, refused when it
#     cannot be reset; RELEASE and
#     FAB_ARCH fallbacks; unmount guard; delta build with parent (overrides,
#     altstrap created and removed, hash file with BT_GPGKEY); repeated
#     export with -u is byte identical; -u without a build; unknown parent;
#     stale altstrap symlink; parent manifest without conf list; product
#     without a debug target; failing make removes the altstrap; TERM default;
#     a rootfs layer with a unit; a child that composes the same unit; a child
#     that adds one; a child with no unit of its own; a unit pinned to another
#     version than the parent applied; a unit whose conf fab would skip; a
#     parent manifest written before the units field existed.

# pipefail as the scripts under test set it: a library function that
# inherits a pipeline's status must fail here and not in production.
set -o pipefail

fatal() { echo "FATAL [$(basename "$0")]: $*" 1>&2; exit 1; }
info() { echo "INFO [$(basename "$0")]: $*"; }

usage() {
cat<<EOF
Syntax: $0
Test bt-layer and bin/layer-lib without building anything
EOF
exit 1
}

[[ "$1" != "-h" ]] && [[ "$1" != "--help" ]] || usage

BT=$(dirname "$(dirname "$(readlink -f "$0")")")
export BT
source "$BT/bin/layer-lib"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

expect_fail() {
    local label=$1
    shift
    if "$@" >/dev/null 2>&1; then
        fatal "$label: should have failed"
    fi
}

expect_ok() {
    local label=$1
    shift
    "$@" >/dev/null 2>&1 || fatal "$label: should have passed"
}

assert_eq() {
    local label=$1
    local got=$2
    local want=$3
    [[ "$got" == "$want" ]] || fatal "$label: got '$got', want '$want'"
}

assert_file() {
    [[ -f "$1" ]] || fatal "missing file: $1"
}

write_product() {
    local dir=$1
    local conf=$2
    local overlays=$3
    mkdir -p "$dir"
    cat > "$dir/Makefile" <<EOF
COMMON_CONF := $conf
COMMON_OVERLAYS := $overlays

# as share/product.mk defines them
UNIT_DIRS ?= unit.d
UNITS ?= \$(sort \$(wildcard \$(UNIT_DIRS)/*))

debug:
	\$(foreach v,\$(V),\$(warning \$(v) = \$(\$(v))))
	@true

clean:
	rm -rf build

build/stamps/root.patched:
	test ! -f FAIL
	mkdir -p build/stamps build/root.patched/bin build/root.patched/etc
	mkdir -p build/.deck/root.build/upper/usr/lib
	mkdir -p build/.deck/root.build/upper/var/cache/apt/archives/partial
	mkdir -p build/.deck/root.patched/upper/etc
	printf '#!/bin/sh\\n' > build/root.patched/bin/bash
	chmod 755 build/root.patched/bin/bash
	echo hostname > build/root.patched/etc/hostname
	mkdir -p build/root.patched/var/lib/dbus
	echo f0e97605ab594989b4d78f4a126b5b37 > build/root.patched/etc/machine-id
	cp build/root.patched/etc/machine-id build/root.patched/var/lib/dbus/machine-id
	if [ -f IDDIR ]; then rm build/root.patched/etc/machine-id && mkdir -p build/root.patched/etc/machine-id/x; fi
	if [ -f LEAK ]; then mkdir -p build/root.patched/etc/ssh && cp LEAK build/root.patched/etc/ssh/ssh_host_rsa_key; fi
	echo lib > build/.deck/root.build/upper/usr/lib/x.so
	echo deb > build/.deck/root.build/upper/var/cache/apt/archives/x.deb
	echo bin > build/.deck/root.build/upper/var/cache/apt/pkgcache.bin
	echo conf > build/.deck/root.patched/upper/etc/x.conf
	echo "\$(COMMON_OVERLAYS)" > build/overlays.used
	echo "\$(COMMON_CONF)" > build/conf.used
	echo "\$(UNITS)" > build/units.used
	echo "\$\$TERM" > build/term.used
	readlink "\$(FAB_PATH)/altstraps/trixie-amd64.core" > build/altstrap.used || true
	touch build/stamps/root.patched
EOF
}

info "1: layer_kind"
assert_eq kind-rootfs "$(layer_kind "")" rootfs
assert_eq kind-delta "$(layer_kind core)" delta

info "2: layer_altstrap_path"
assert_eq altstrap "$(layer_altstrap_path /turnkey/fab trixie amd64)" \
    /turnkey/fab/altstraps/trixie-amd64.core

info "3: layer_epoch"
gitdir=$tmp/gitprod
mkdir -p "$gitdir"
git -C "$gitdir" init -q
GIT_COMMITTER_DATE=@1600000000 git -C "$gitdir" -c user.name=t -c user.email=t@[2001:db8::1] \
    commit -q --allow-empty --date=@1600000000 -m init
assert_eq epoch-env "$(SOURCE_DATE_EPOCH=1700000000 layer_epoch "$gitdir")" 1700000000
expect_fail epoch-invalid env SOURCE_DATE_EPOCH=soon bash -c \
    "source '$BT/bin/layer-lib'; layer_epoch '$gitdir'"
assert_eq epoch-git "$(SOURCE_DATE_EPOCH= layer_epoch "$gitdir")" 1600000000
mkdir -p "$tmp/nogit"
expect_fail epoch-nogit env SOURCE_DATE_EPOCH= bash -c \
    "source '$BT/bin/layer-lib'; layer_epoch '$tmp/nogit'"

info "4: layer_git_commit"
assert_eq commit-git "$(layer_git_commit "$gitdir")" "$(git -C "$gitdir" rev-parse HEAD)"
assert_eq commit-none "$(layer_git_commit "$tmp/nogit")" none

info "5: layer_make_var"
write_product "$tmp/products/core" "turnkey.d" "turnkey.d"
assert_eq make-var "$(layer_make_var "$tmp/products/core" COMMON_CONF)" turnkey.d
expect_fail make-var-fail layer_make_var "$tmp/nogit" COMMON_CONF

info "6: layer_words_has and layer_words_minus"
layer_words_has "a b c" b || fatal "words_has: b not found"
expect_fail words-has-missing layer_words_has "a b c" d
assert_eq words-minus "$(layer_words_minus "a b c d" "b d")" "a c"
assert_eq words-minus-empty "$(layer_words_minus "a" "a")" ""

info "7: layer_child_conf"
conf_path=$tmp/common/conf
mkdir -p "$conf_path"
echo 'cat /tmp/ZZ_SSL_CIPHERS' > "$conf_path/apache-ssl"
echo 'true' > "$conf_path/php"
core_conf="turnkey.d"
lamp_conf="turnkey.d tkl-webcp apache-cgi apache-ssl php mysql"
wp_conf="turnkey.d apache-credit apache-cgi apache-ssl php mysql"
assert_eq child-conf-stack "$(layer_child_conf "$lamp_conf" "$core_conf" "$conf_path")" \
    "turnkey.d/hostname turnkey.d/zz-ssl-ciphers tkl-webcp apache-cgi apache-ssl php mysql"
assert_eq child-conf-app "$(layer_child_conf "$wp_conf" "$lamp_conf" "$conf_path")" \
    "turnkey.d/hostname apache-credit php"
assert_eq child-conf-plain "$(layer_child_conf "a b" "a" "$conf_path")" "b"
overlays_path=$tmp/common/overlays
mkdir -p "$overlays_path/nginx/etc/nginx/snippets" "$overlays_path/plain"
echo "ssl_ciphers 'ZZ_SSL_CIPHERS';" > "$overlays_path/nginx/etc/nginx/snippets/ssl.conf"
echo 'x' > "$overlays_path/plain/file"
nginx_conf="turnkey.d nginx"
assert_eq child-conf-overlay-mark "$(layer_child_conf "$nginx_conf" "$core_conf" "$conf_path" \
    "$overlays_path" "turnkey.d/tkl-bashlib nginx")" \
    "turnkey.d/hostname turnkey.d/zz-ssl-ciphers nginx"
assert_eq child-conf-overlay-plain "$(layer_child_conf "$nginx_conf" "$core_conf" "$conf_path" \
    "$overlays_path" "turnkey.d/tkl-bashlib plain")" \
    "turnkey.d/hostname nginx"

info "8: layer_child_overlays"
assert_eq child-overlays "$(layer_child_overlays "turnkey.d apache php" "turnkey.d")" \
    "turnkey.d/tkl-bashlib turnkey.d/systemd-chroot apache php"
assert_eq child-overlays-none "$(layer_child_overlays "turnkey.d" "turnkey.d")" \
    "turnkey.d/tkl-bashlib turnkey.d/systemd-chroot"

info "8b: layer_unit_digest"
units=$tmp/units
write_unit() {
    local dir=$units/$1
    mkdir -p "$dir/overlay/etc"
    echo "${2:-body}" > "$dir/overlay/etc/file"
    printf '#!/bin/sh\ntrue\n' > "$dir/conf"
    chmod 755 "$dir/conf"
    : > "$dir/plan"
}
write_unit alpha
write_unit beta
digest_alpha=$(layer_unit_digest "$units/alpha")
[[ "$digest_alpha" =~ ^sha256-[0-9a-f]{16}$ ]] \
    || fatal "digest is not sha256- plus 16 hex digits: $digest_alpha"
assert_eq digest-same "$(layer_unit_digest "$units/beta")" "$digest_alpha"
assert_eq digest-stable "$(layer_unit_digest "$units/alpha")" "$digest_alpha"
echo other > "$units/beta/overlay/etc/file"
[[ "$(layer_unit_digest "$units/beta")" != "$digest_alpha" ]] \
    || fatal "digest ignores file content"
echo "${digest_alpha}" > /dev/null
write_unit gamma
chmod 700 "$units/gamma/overlay/etc"
[[ "$(layer_unit_digest "$units/gamma")" != "$digest_alpha" ]] \
    || fatal "digest ignores the mode of a directory"
write_unit delta
ln -s file "$units/delta/overlay/etc/link"
digest_delta=$(layer_unit_digest "$units/delta")
[[ "$digest_delta" != "$digest_alpha" ]] || fatal "digest ignores a symlink"
ln -sfn other "$units/delta/overlay/etc/link"
[[ "$(layer_unit_digest "$units/delta")" != "$digest_delta" ]] \
    || fatal "digest ignores a symlink target"
write_unit epsilon
git -C "$units/epsilon" init -q
assert_eq digest-ignores-git "$(layer_unit_digest "$units/epsilon")" "$digest_alpha"
expect_fail digest-missing layer_unit_digest "$tmp/no-such-unit"

info "8c: layer_unit_version"
echo '1.2.0' > "$units/alpha/version"
assert_eq version-file "$(layer_unit_version "$units/alpha")" 1.2.0
printf '# the pin\n\n 2.0.0~rc1 \n' > "$units/alpha/version"
assert_eq version-file-comment "$(layer_unit_version "$units/alpha")" "2.0.0~rc1"
echo 'not a version' > "$units/alpha/version"
expect_fail version-file-bad layer_unit_version "$units/alpha"
echo 'a@b' > "$units/alpha/version"
expect_fail version-file-at layer_unit_version "$units/alpha"
printf 'v%065d\n' 1 > "$units/alpha/version"
expect_fail version-file-long layer_unit_version "$units/alpha"
rm "$units/alpha/version"
assert_eq version-digest "$(layer_unit_version "$units/alpha")" "$digest_alpha"
own=$tmp/own-checkout
mkdir -p "$own"
write_unit_at() {
    mkdir -p "$1/overlay"
    echo body > "$1/overlay/file"
}
write_unit_at "$own"
git -C "$own" init -q
git -C "$own" -c user.name=t -c user.email=t@[2001:db8::1] add -A
git -C "$own" -c user.name=t -c user.email=t@[2001:db8::1] commit -q -m unit
assert_eq version-own-git "$(layer_unit_version "$own")" "$(git -C "$own" rev-parse HEAD)"
inner=$own/unit.d/nested
write_unit_at "$inner"
[[ "$(layer_unit_version "$inner")" != "$(git -C "$own" rev-parse HEAD)" ]] \
    || fatal "a unit inside a repository reported the repository's commit"
assert_eq version-nested-digest "$(layer_unit_version "$inner")" \
    "$(layer_unit_digest "$inner")"

info "8d: layer_unit_check"
expect_ok unit-check-full layer_unit_check "$units/beta"
mkdir -p "$units/plan-only"
: > "$units/plan-only/plan"
expect_ok unit-check-plan-only layer_unit_check "$units/plan-only"
mkdir -p "$units/empty"
expect_fail unit-check-empty layer_unit_check "$units/empty"
mkdir -p "$units/notexec/overlay"
printf '#!/bin/sh\ntrue\n' > "$units/notexec/conf"
chmod 644 "$units/notexec/conf"
expect_fail unit-check-notexec layer_unit_check "$units/notexec"
mkdir -p "$units/flatoverlay"
: > "$units/flatoverlay/overlay"
expect_fail unit-check-overlay-file layer_unit_check "$units/flatoverlay"

info "8e: layer_units"
prod=$tmp/unitprod
mkdir -p "$prod"
assert_eq units-no-dir "$(layer_units "$prod" unit.d)" none
assert_eq units-no-var "$(layer_units "$prod" "")" none
mkdir -p "$prod/unit.d"
assert_eq units-empty-dir "$(layer_units "$prod" unit.d)" none
cp -a "$units/beta" "$prod/unit.d/mariadb"
echo '1.0.0' > "$prod/unit.d/mariadb/version"
cp -a "$units/plan-only" "$prod/unit.d/adminer"
echo '0.9' > "$prod/unit.d/adminer/version"
assert_eq units-sorted "$(layer_units "$prod" unit.d)" "adminer@0.9 mariadb@1.0.0"
: > "$prod/unit.d/README"
expect_fail units-not-a-dir layer_units "$prod" unit.d
rm "$prod/unit.d/README"
mkdir -p "$prod/unit.d/Bad_Name"
: > "$prod/unit.d/Bad_Name/plan"
expect_fail units-bad-name layer_units "$prod" unit.d
rm -rf "$prod/unit.d/Bad_Name"
mkdir -p "$prod/unit.d/hollow"
expect_fail units-hollow layer_units "$prod" unit.d
rm -rf "$prod/unit.d/hollow"
assert_eq units-after-cleanup "$(layer_units "$prod" unit.d)" "adminer@0.9 mariadb@1.0.0"

info "8f: layer_units_version, layer_child_units, layer_units_merge, layer_unit_paths"
assert_eq units-version "$(layer_units_version "adminer@0.9 mariadb@1.0.0" mariadb)" 1.0.0
assert_eq units-version-missing "$(layer_units_version "adminer@0.9" mariadb)" ""
assert_eq units-version-none "$(layer_units_version none mariadb)" ""
assert_eq child-units-all "$(layer_child_units "adminer@0.9 mariadb@1.0.0" none)" \
    "adminer@0.9 mariadb@1.0.0"
assert_eq child-units-partial \
    "$(layer_child_units "adminer@0.9 mariadb@1.0.0" "mariadb@1.0.0")" "adminer@0.9"
assert_eq child-units-none \
    "$(layer_child_units "mariadb@1.0.0" "adminer@0.9 mariadb@1.0.0")" none
assert_eq child-units-own-none "$(layer_child_units none "mariadb@1.0.0")" none
expect_fail child-units-conflict layer_child_units "mariadb@2.0.0" "mariadb@1.0.0"
assert_eq merge-none "$(layer_units_merge none none)" none
assert_eq merge-own "$(layer_units_merge none "mariadb@1.0.0")" "mariadb@1.0.0"
assert_eq merge-parent "$(layer_units_merge "mariadb@1.0.0" none)" "mariadb@1.0.0"
assert_eq merge-union "$(layer_units_merge "mariadb@1.0.0" "adminer@0.9")" \
    "adminer@0.9 mariadb@1.0.0"
assert_eq merge-overlap "$(layer_units_merge "mariadb@1.0.0" "mariadb@1.0.0")" \
    "mariadb@1.0.0"
assert_eq paths-none "$(layer_unit_paths unit.d none)" ""
assert_eq paths-two "$(layer_unit_paths unit.d "adminer@0.9 mariadb@1.0.0")" \
    "unit.d/adminer unit.d/mariadb"

info "9: layer_manifest_render and layer_manifest_get"
manifest=$tmp/test.manifest
layer_manifest_render layer core sha256 abc common_conf "turnkey.d php" > "$manifest"
assert_eq manifest-get "$(layer_manifest_get "$manifest" common_conf)" "turnkey.d php"
assert_eq manifest-get-first "$(layer_manifest_get "$manifest" layer)" core
expect_fail manifest-odd layer_manifest_render layer core sha256
expect_fail manifest-badkey layer_manifest_render "Bad Key" x
expect_fail manifest-nofile layer_manifest_get "$tmp/none.manifest" sha256
expect_fail manifest-nokey layer_manifest_get "$manifest" size
assert_eq manifest-opt "$(layer_manifest_opt "$manifest" common_conf none)" "turnkey.d php"
assert_eq manifest-opt-default "$(layer_manifest_opt "$manifest" units none)" none
expect_fail manifest-opt-nofile layer_manifest_opt "$tmp/none.manifest" units none

info "10: layer_tar_flags and layer_tar_members"
flags=$(layer_tar_flags 1700000000)
for want in --sort=name --mtime=@1700000000 --numeric-owner --xattrs \
        "--xattrs-include=trusted.overlay.*" "--exclude=./var/cache/apt/archives/*" \
        "--pax-option=exthdr.name=%d/PaxHeaders/%f,delete=atime,delete=ctime"; do
    grep -qxF -- "$want" <<<"$flags" || fatal "tar flag missing: $want"
done
assert_eq members-rootfs "$(layer_tar_members rootfs /b | tr '\n' ' ')" "-C /b/root.patched . "
assert_eq members-delta "$(layer_tar_members delta /b | tr '\n' ' ')" \
    "-C /b/.deck/root.build/upper . -C /b/.deck/root.patched/upper . "
expect_fail members-unknown layer_tar_members squashfs /b

info "10b: layer_audit_packages"
audit_root=$tmp/auditfs
mkdir -p "$audit_root/var/lib/dpkg"
cat > "$audit_root/var/lib/dpkg/status" << 'STATUS'
Package: bash
Status: install ok installed
Version: 5.2

Package: confconsole
Status: install ok unpacked
Version: 2.2.3+keel1

STATUS
expect_fail audit-unconfigured layer_audit_packages "$audit_root"
cat > "$audit_root/var/lib/dpkg/status" << 'STATUS'
Package: bash
Status: install ok installed
Version: 5.2

Package: confconsole
Status: install ok installed
Version: 2.2.3+keel1

STATUS
expect_ok audit-clean layer_audit_packages "$audit_root"
LAYER_DPKG_QUERY=$tmp/no-such-dpkg-query expect_fail audit-no-dpkg layer_audit_packages "$audit_root"
cat > "$audit_root/var/lib/dpkg/status" << 'STATUS'
Package: ghost
Status: unknown ok not-installed

STATUS
expect_ok audit-unknown-ignored layer_audit_packages "$audit_root"

info "10c: layer_audit_keys"
keys_root=$tmp/keysfs
keys_list=$tmp/inert-keys
mkdir -p "$keys_root/etc/ssl/private" "$keys_root/etc/ssh" "$keys_root/usr/share/doc/ex" "$keys_root/usr/bin"
printf 'hostname\n' > "$keys_root/etc/hostname"
printf '# comment only\n\n' > "$keys_list"
expect_ok keys-clean layer_audit_keys "$keys_root" "$keys_list"
expect_fail keys-no-list layer_audit_keys "$keys_root" "$tmp/no-such-list"
expect_fail keys-no-root layer_audit_keys "$tmp/no-such-root" "$keys_list"
# a key on its own, the way turnkey-ssl ships /etc/ssl/private/cert.key
printf -- '-----BEGIN PRIVATE KEY-----\nMIIE\n-----END PRIVATE KEY-----\n' \
    > "$keys_root/etc/ssl/private/cert.key"
expect_fail keys-pkcs8 layer_audit_keys "$keys_root" "$keys_list"
out=$(layer_audit_keys "$keys_root" "$keys_list" 2>&1) || true
[[ "$out" == *"/etc/ssl/private/cert.key"* ]] || fatal "keys-pkcs8: path not named: $out"
[[ "$out" != *"$keys_root/etc"* ]] || fatal "keys-pkcs8: names the build tree, not the image path: $out"
rm "$keys_root/etc/ssl/private/cert.key"
# a key after a certificate in one file, the way cert.pem combines them
printf -- '-----BEGIN CERTIFICATE-----\nMIID\n-----END CERTIFICATE-----\n-----BEGIN RSA PRIVATE KEY-----\nMIIE\n-----END RSA PRIVATE KEY-----\n' \
    > "$keys_root/etc/ssl/private/cert.pem"
expect_fail keys-combined layer_audit_keys "$keys_root" "$keys_list"
rm "$keys_root/etc/ssl/private/cert.pem"
# an OpenSSH host key, and every offender named, not only the first
printf -- '-----BEGIN OPENSSH PRIVATE KEY-----\nb3Bl\n-----END OPENSSH PRIVATE KEY-----\n' \
    > "$keys_root/etc/ssh/ssh_host_ed25519_key"
printf -- '-----BEGIN EC PRIVATE KEY-----\nMHc\n-----END EC PRIVATE KEY-----\n' \
    > "$keys_root/etc/ssh/ssh_host_ecdsa_key"
out=$(layer_audit_keys "$keys_root" "$keys_list" 2>&1) && fatal "keys-openssh: should have failed"
[[ "$out" == *"/etc/ssh/ssh_host_ed25519_key"* ]] || fatal "keys-openssh: ed25519 not named: $out"
[[ "$out" == *"/etc/ssh/ssh_host_ecdsa_key"* ]] || fatal "keys-openssh: ecdsa not named: $out"
rm "$keys_root/etc/ssh/ssh_host_ed25519_key" "$keys_root/etc/ssh/ssh_host_ecdsa_key"
# an armoured OpenPGP secret key, whose header ends in BLOCK
mkdir -p "$keys_root/root/.gnupg"
printf -- '-----BEGIN PGP PRIVATE KEY BLOCK-----\n\nlQ\n-----END PGP PRIVATE KEY BLOCK-----\n' > "$keys_root/root/.gnupg/secret.asc"
expect_fail keys-pgp layer_audit_keys "$keys_root" "$keys_list"
rm "$keys_root/root/.gnupg/secret.asc"
# an armoured OpenPGP public key is not secret
printf -- '-----BEGIN PGP PUBLIC KEY BLOCK-----\n\nmQ\n-----END PGP PUBLIC KEY BLOCK-----\n' > "$keys_root/root/.gnupg/public.asc"
expect_ok keys-pgp-public layer_audit_keys "$keys_root" "$keys_list"
# the marker quoted inside a line is not a key file
printf 'marker = "-----BEGIN PRIVATE KEY-----"\n' > "$keys_root/usr/share/doc/ex/parser.py"
expect_ok keys-quoted layer_audit_keys "$keys_root" "$keys_list"
# a binary that carries the marker as a string, the way ssh-keygen does
printf 'ELF\0\0\n-----BEGIN OPENSSH PRIVATE KEY-----\n\0' > "$keys_root/usr/bin/ssh-keygen"
expect_ok keys-binary layer_audit_keys "$keys_root" "$keys_list"
# a symlink is not followed out of the tree
printf -- '-----BEGIN PRIVATE KEY-----\nMIIE\n-----END PRIVATE KEY-----\n' > "$tmp/outside.key"
ln -s "$tmp/outside.key" "$keys_root/etc/ssl/private/link.key"
expect_ok keys-symlink layer_audit_keys "$keys_root" "$keys_list"
rm "$keys_root/etc/ssl/private/link.key"
